# 统一换行：文本 CRLF（Windows 项目），二进制保持原样
* text=auto

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.md   text eol=crlf
*.json text eol=crlf
*.yml  text eol=crlf
*.yaml text eol=crlf
*.cjs  text eol=crlf

*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
